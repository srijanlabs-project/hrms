# Used only by `prisma migrate`/`prisma generate` (needs DDL rights) — the running
# app never connects with this role. See RUNTIME_DATABASE_URL below.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/hrms?schema=public"

# Used by the NestJS app at runtime — least-privilege role with no DDL rights, so
# Postgres RLS policies actually apply (RLS is bypassed for table owners/superusers).
RUNTIME_DATABASE_URL="postgresql://hrms_app:CHANGE_ME@localhost:5432/hrms?schema=public"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"
OTP_STATIC_DEV_CODE="12345"
PORT=8090
NODE_ENV=development
